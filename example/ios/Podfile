ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# VS Code / shell sessions may inject debugger flags through NODE_OPTIONS.
# CocoaPods uses `node` during Podfile evaluation, and those flags can corrupt
# the resolved script path output. Clear them for pod install execution.
ENV['NODE_OPTIONS'] = ''

require 'fileutils'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ArkSecurityManagerExample' do
  config = use_native_modules!

  # Local ARK Security Manager iOS SDK
  # The native SDK source must exist at:
  #   <repo-root>/native/ios/Modules/ARKSecurityManager/
  pod "ARKSecurityManager", :path => "../../native/ios/Modules/ARKSecurityManager"

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_configuration|
        definitions = build_configuration.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = Array(definitions)
        c_flags = build_configuration.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        c_flags = Array(c_flags)
        cxx_flags = build_configuration.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cxx_flags = Array(cxx_flags)

        unless definitions.include?('FMT_USE_CONSTEVAL=0')
          definitions << 'FMT_USE_CONSTEVAL=0'
        end

        unless definitions.include?('FMT_USE_NONTYPE_TEMPLATE_ARGS=0')
          definitions << 'FMT_USE_NONTYPE_TEMPLATE_ARGS=0'
        end

        ['-DFMT_USE_CONSTEVAL=0', '-DFMT_USE_NONTYPE_TEMPLATE_ARGS=0'].each do |flag|
          c_flags << flag unless c_flags.include?(flag)
          cxx_flags << flag unless cxx_flags.include?(flag)
        end

        build_configuration.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
        build_configuration.build_settings['OTHER_CFLAGS'] = c_flags
        build_configuration.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxx_flags
        build_configuration.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    fmt_base_header = File.join(
      installer.sandbox.root.to_s,
      'fmt',
      'include',
      'fmt',
      'base.h'
    )

    if File.exist?(fmt_base_header)
      fmt_header_contents = File.read(fmt_base_header)
      original_fmt_guard = <<~TEXT
        #elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L
        #  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14.
      TEXT
      patched_fmt_guard = <<~TEXT
        #elif defined(__apple_build_version__)
        #  define FMT_USE_CONSTEVAL 0  // Disabled for Apple clang by the example Podfile workaround.
      TEXT

      if fmt_header_contents.include?(original_fmt_guard)
        FileUtils.chmod('u+w', fmt_base_header)
        File.write(
          fmt_base_header,
          fmt_header_contents.sub(original_fmt_guard, patched_fmt_guard)
        )
      end
    end
  end
end
